{
  "name": "bla-agents",
  "version": "1.5.2",
  "description": "BLA (Blind LLM Agents) — Adversarial defense shield that protects binaries, Electron apps, JS bundles, Python, WebAssembly, SQLite, AI Models, and Android DEX/IL2CPP against AI reverse-engineering agents like REA.",
  "keywords": [
    "reverse-engineering-defense",
    "anti-rea",
    "rea",
    "llm-security",
    "adversarial-defense",
    "obfuscation",
    "algorithmic-tarpit",
    "electron-security",
    "asar",
    "wasm",
    "binary-protection",
    "mcp",
    "coding-agents",
    "claude-code",
    "cursor"
  ],
  "homepage": "https://bla.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qybaihe/bla.git"
  },
  "bugs": {
    "url": "https://github.com/qybaihe/bla/issues"
  },
  "license": "MIT",
  "author": "BLA Contributors",
  "type": "module",
  "bin": {
    "bla": "./dist/cli.js",
    "bla-agents": "./dist/cli.js",
    "bla-shield": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundler": {
      "types": "./dist/bundler/index.d.ts",
      "default": "./dist/bundler/index.js"
    }
  },
  "files": [
    "dist",
    ".agents/skills/blind-llm-agents",
    "README.md",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "engines": {
    "node": "^22.23.4 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "node dist/cli.js benchmark",
    "version": "node scripts/sync-version.mjs && git add src/identity.ts",
    "sync:site": "node scripts/sync-site.mjs",
    "release:patch": "npm version patch -m 'chore(release): bla-agents v%s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'chore(release): bla-agents v%s' && git push --follow-tags",
    "prepublishOnly": "npm run build && npm test",
    "verify:rea": "node scripts/verify-rea-constants.mjs",
    "redteam:rea": "node scripts/redteam/run.mjs",
    "verify:rea:drift": "node scripts/verify-rea-constants.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
